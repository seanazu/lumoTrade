# API Configuration
PORT=8000

# OpenAI API
OPENAI_API_KEY=sk-your-key-here

# Data Provider APIs
POLYGON_API_KEY=your-polygon-key
FMP_API_KEY=your-fmp-key
MARKETAUX_API_KEY=your-marketaux-key

# Model Configuration
MODEL_PATH=models/best_model.pth
SCALER_PATH=models/scaler.pkl
SEQUENCE_LENGTH=60

# Training Configuration
BATCH_SIZE=32
LEARNING_RATE=0.001
EPOCHS=100
VALIDATION_SPLIT=0.2

# Prediction Configuration
PREDICTION_UPDATE_INTERVAL=60  # seconds
CACHE_TTL=300  # seconds

# Sentiment Weights
NEWS_SENTIMENT_WEIGHT=0.35
SOCIAL_SENTIMENT_WEIGHT=0.25
GPT_WEIGHT=0.25
LSTM_WEIGHT=0.15

# Database (optional, for storing predictions/accuracy)
# DATABASE_URL=postgresql://user:pass@localhost/lumotrade

